# Copy to .env. Generate separate fresh secrets; never commit real values.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_HTTPS=False
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
CHAT_API_TOKEN=
CHAT_RATE=20/min
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
# Optional: defaults to .data/chroma under repo root
# RAG_STORE_PATH=
RAG_COLLECTION=batam-tourism-v1
